<?xml version="1.0" encoding="utf-8"?>
<!-- วิดเจ็ตไฟวันต่อเนื่อง (StreakCore.draw) · ซ้าย: มาสคอตแมว (ท่าเปลี่ยนตามสถานการณ์ ภาพ res/drawable-nodpi/mw_*.png ก๊อปจาก mascot/) · ขวา: แถวบน ไฟ+ตัวเลข+วันนี้ x/2+กันไฟดับ · แถวล่าง ข้อความสั้นสุ่มตามสถานการณ์ (streak-msgs.js w_*) บรรทัดเดียว ปรับขนาดตัวอักษรอัตโนมัติ 8–14sp ให้พอดีความกว้าง (autoSize · ยาวเกินที่ 8sp = ตัดด้วย …)
     สีพื้นเปลี่ยนตามสถานการณ์ (stk_bg / _lit / _warn / _ice) · สูงรวมราว 66dp → พอดีวิดเจ็ตสูง 1 ช่อง -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stk_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/stk_mascot"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:contentDescription="มาสคอตแมว"
        android:scaleType="fitCenter"
        android:src="@drawable/mw_peace" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/stk_flame"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="ไฟ"
            android:src="@drawable/stk_flame_off" />

        <TextView
            android:id="@+id/stk_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:includeFontPadding="false"
            android:text="-"
            android:textColor="#8B8F8D"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stk_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:text="0/2"
            android:textColor="#D4D4D8"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginStart="8dp"
            android:contentDescription="กันไฟดับ"
            android:src="@drawable/stk_snow" />

        <TextView
            android:id="@+id/stk_frz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="0"
            android:textColor="#7CC4FF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/stk_msg"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="2dp"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeStepGranularity="0.5sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text=""
        android:textColor="#D4D4D8"
        android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
