<?xml version="1.0" encoding="utf-8"?>
<!-- วิดเจ็ตไฟวันต่อเนื่อง (StreakCore.draw) · ซ้อนชั้น: ฉากพื้นหลังพิกเซล (สลับทุก 3 ชม. · อารมณ์ตามสถานการณ์ drawable-nodpi/stk_bg_<ฉาก>_<n|d|e|f>.png)
     → ข้อความสั้นแถวบนจัดกึ่งกลาง (บรรทัดเดียว ปรับขนาดอัตโนมัติ) → ตัวเลขสตรีค+ไฟ (StreakArt.stats) + ช่องความคืบหน้า (StreakArt.blocks) + บรรทัดเล็ก "วันนี้ x/2 · กันไฟ n" → มาสคอตแมว (mw_<ท่า>.png)
     มุมมน 22dp ตัดเองด้วย background รูปทรงมน + clipToOutline (launcher บางตัวไม่ตัดมุมให้) · centerCrop = ย่อ/ขยายวิดเจ็ตแล้วภาพไม่เบี้ยว
     ข้อความ 2 จุดเป็น ImageView เพราะวาดตัวหนังสือมีขอบดำเอง (StreakArt.text) · TextView ทำขอบตัวอักษรไม่ได้ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stk_round"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/stk_bgimg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/stk_bg_meadow_n" />

    <ImageView
        android:id="@+id/stk_mascot"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="3dp"
        android:layout_marginBottom="1dp"
        android:contentDescription="มาสคอตแมว"
        android:scaleType="fitCenter"
        android:src="@drawable/mw_peace" />

    <ImageView
        android:id="@+id/stk_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="3dp"
        android:contentDescription="@null"
        android:scaleType="fitStart" />

    <ImageView
        android:id="@+id/stk_stats"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="64dp"
        android:layout_marginTop="31dp"
        android:adjustViewBounds="true"
        android:contentDescription="สตรีค"
        android:scaleType="fitStart" />

    <ImageView
        android:id="@+id/stk_prog"
        android:layout_width="wrap_content"
        android:layout_height="11dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="39dp"
        android:layout_marginEnd="9dp"
        android:adjustViewBounds="true"
        android:contentDescription="ความคืบหน้าวันนี้"
        android:scaleType="fitEnd" />

    <ImageView
        android:id="@+id/stk_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="66dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="@null"
        android:scaleType="fitStart" />
</FrameLayout>
