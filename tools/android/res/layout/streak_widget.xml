<?xml version="1.0" encoding="utf-8"?>
<!-- วิดเจ็ตไฟวันต่อเนื่อง (StreakCore.renderWidgets) · ขนาดประมาณวิดเจ็ต Duolingo 2×1 ยืดได้ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stk_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/stk_flame"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="ไฟ"
        android:src="@drawable/stk_flame_off" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stk_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="-"
            android:textColor="#8B8F8D"
            android:textSize="30sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/stk_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="วันนี้ 0/2"
                android:textColor="#D4D4D8"
                android:textSize="13sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:contentDescription="กันไฟดับ"
                android:src="@drawable/stk_snow" />

            <TextView
                android:id="@+id/stk_frz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="0"
                android:textColor="#7CC4FF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
